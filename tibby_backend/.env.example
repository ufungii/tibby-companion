# Demo provider is deterministic and makes no external API calls.
TIBBY_PROVIDER=demo

# Optional: switch to navigator to interpret text and transcribe WAV uploads.
# Use a model your team's key can access. These values stay on the server.
NAVIGATOR_TOOLKIT_API_KEY=
NAVIGATOR_CHAT_MODEL=
NAVIGATOR_STT_MODEL=whisper-large-v3

# Exact web-preview origins only. Native phone apps do not require CORS.
TIBBY_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
