{
  "expo": {
    "name": "TIBBY Companion",
    "slug": "tibby-companion",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.tibby.companion",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to the TIBBY development backend on your local network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f3f6f2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.tibby.companion",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./public/icons/tibby-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Connect to the TIBBY wearable to receive microphone recordings."
        }
      ]
    ],
    "scheme": "tibby",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ea0f6763-49b7-4a0d-908f-d82ff066c72b"
      }
    },
    "owner": "wnhdkk"
  }
}
