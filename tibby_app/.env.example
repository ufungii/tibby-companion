# Set once by the team when building the app. All users use this shared HTTPS
# endpoint automatically; they never enter it in the app. This is not a secret.
# No API keys or credentials belong in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_BACKEND_URL=https://tibby-backend-9le6.onrender.com

# Explicit local UI demo only. Never silently falls back when a server fails.
EXPO_PUBLIC_DEMO_MODE=false
